# Here we set a bunch of parameters for your image build

# Display and OCI title. Registry refs are lowercased to ryven (OCI requirement).
IMAGE_NAME=Ryven

# Make this the same as your github username/organisation
REPO_ORGANIZATION="mheci"

IMAGE_DESC="Ryven bootc daily driver derived from ublue-os/base-main"
IMAGE_KEYWORDS="bootc,oci,linux,ublue,ryven"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/274998646?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
