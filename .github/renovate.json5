{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
  ],

  "rebaseWhen": "never",
  "dependencyDashboard": true,

  "enabledManagers": [
    "dockerfile",
    "github-actions",
    "pre-commit",
    "custom.regex",
  ],

  // Zero-maintenance policy: the Ryven Containerfiles use floating Fedora
  // release tags (e.g. ':44'), never digest or version pins. Digest pinning
  // is disabled so Renovate keeps the tags floating; it manages the tags
  // themselves (44 -> 45) via the packageRules below.
  "dockerfile": {
    "pinDigests": false,
  },

  "pre-commit": {
    "enabled": true,
  },

  "customManagers": [
    {
      "customType": "regex",
      "description": "bootc-image-builder image in ryven.env",
      "managerFilePatterns": ["/(^|/)ryven\\.env$/"],
      "matchStrings": [
        "BIB_IMAGE=\"(?<depName>quay.io/centos-bootc/bootc-image-builder):(?<currentValue>[^\"]+)\"",
      ],
      "datasourceTemplate": "docker",
    },
    {
      "customType": "regex",
      "description": "container-structure-test release pin in image workflows",
      "managerFilePatterns": ["/(^|/)\\.github/workflows/build-ryven.*\\.yml$/"],
      "matchStrings": ["CST_VER: (?<currentValue>v[0-9.]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "GoogleContainerTools/container-structure-test",
    },
  ],

  "packageRules": [
    {
      "automerge": true,
      "matchUpdateTypes": ["pin", "pinDigest"],
    },
    {
      "description": "Automerge base-image tag bumps (e.g. 44 -> 45) for the Ryven Containerfiles",
      "matchManagers": ["dockerfile"],
      "matchDepNames": ["ublue-os/kinoite-main", "ublue-os/base-main"],
      "automerge": true,
    },
    {
      "automerge": true,
      "matchManagers": ["pre-commit"],
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest"],
    },
    {
      "enabled": false,
      "matchUpdateTypes": ["digest", "pinDigest", "pin"],
      "matchDepTypes": ["container"],
      "matchFileNames": [".github/workflows/**.yaml", ".github/workflows/**.yml"],
    },
  ],
}
