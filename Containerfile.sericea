# Ryven-Sericea: Sway on ublue base-main (sericea-main is unpublished/deprecated).
# Kernel (CachyOS COPR) and NVIDIA (Terra akmod-nvidia) resolve at compose time.
FROM scratch AS ctx
COPY build_files /
COPY system_files /system_files
COPY system_files_sericea /system_files_sericea
# The CI host-side "Fetch browsers" step drops the always-latest payloads
# (BetterBird, Firefox, Zen, Brave Origin) into _build/ in the build
# context; the image installs them from /ctx (compose.sh installers).
COPY _build /_build

# Base image: floating ':latest' tag = newest ublue build, no digest or
# version lock (zero-maintenance policy).
FROM ghcr.io/ublue-os/base-main:latest

RUN rm -rf /opt && mkdir -p /opt

RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/var/tmp \
    --mount=type=secret,id=GITHUB_TOKEN \
    /ctx/build-sericea.sh

RUN --mount=type=tmpfs,target=/run --network=none bootc container lint
