# Route D-Bus activation of org.freedesktop.secrets to the oo7 systemd user
# unit instead of spawning a second daemon (SystemdService makes dbus-daemon
# ask the user manager to start the unit that already owns the BusName).
# The ryven-user-units generator starts oo7-daemon eagerly at session start;
# this file is the on-demand fallback (late clients, post-crash reactivation).
# It also guarantees oo7 — not ksecretd or any other Secret Service shim —
# answers activation of the bus name on every image.
[D-BUS Service]
Name=org.freedesktop.secrets
Exec=/usr/bin/oo7-daemon
SystemdService=oo7-daemon.service
