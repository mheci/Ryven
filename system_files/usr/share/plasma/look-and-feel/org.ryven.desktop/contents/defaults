[kdeglobals][KDE]
LookAndFeelPackage=org.ryven.desktop
widgetStyle=Breeze

[kdeglobals][General]
ColorScheme=Ryven
Name=Ryven
TerminalApplication=konsole
TerminalService=org.kde.konsole.desktop

[kdeglobals][Icons]
Theme=breeze-dark

[plasmarc][Theme]
name=default

[kcminputrc][Mouse]
cursorTheme=breeze_cursors

[kwinrc][org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze

[kwinrc][Windows]
BorderlessMaximizedWindows=false

[Wallpaper]
defaultWallpaperTheme=Ryven
defaultFileSuffix=.png
defaultWidth=3840
defaultHeight=2160
Image=file:///usr/share/wallpapers/Ryven/

[ksplashrc][KSplash]
Engine=none
Theme=None
