#!/usr/bin/env bash
# CachyOS-style PCI latency timer reduction at boot (Arch wiki Gaming ->
# Improve PCI Latencies): cap the maximum cycles a PCI client may occupy the
# bus.
#   20  all devices
#   0   root PCI bridge (0:0)
#   80  audio devices (class 04xx) — keep audio latency stable
# Best effort: a failed setpci on one device must not fail the boot unit.
set -euo pipefail

command -v setpci >/dev/null 2>&1 || exit 0
setpci -v -s '*:*' latency_timer=20 2>/dev/null || true
setpci -v -s '0:0' latency_timer=0 2>/dev/null || true
setpci -v -d '*:*:04xx' latency_timer=80 2>/dev/null || true
